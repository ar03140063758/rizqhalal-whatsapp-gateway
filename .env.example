# ---------------------------------------------------------------------------
# RizqHalal WhatsApp gateway
#
# Copy this file to .env (local only - never commit it) and fill the two
# Supabase values. On Render these are set in the dashboard instead.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://hsenqodyczbjetazzdgx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# Render sets PORT automatically. Locally 10000 is fine.
PORT=10000

# fatal | error | warn | info | debug
LOG_LEVEL=info

# Optional: public URL of this service, shown in the logs.
GATEWAY_URL=

# The Next.js site and the class-lifecycle secret. The gateway pings
# /api/class-lifecycle every minute so the 5-minute reminders fire even when
# nobody has the dashboard open.
APP_URL=https://rizqhalal.site
CRON_SECRET=the-same-value-as-vercel
